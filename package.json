{
  "name": "dsh-session-cleaner",
  "version": "0.9.3",
  "description": "DSH 会话清理插件：删除至回收站、撤销与可继续恢复，支持子会话级联、归档管理、正文搜索、批量处理、Markdown/JSON 导出及可配置保留期。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "session",
    "delete",
    "recycle-bin",
    "cleaner"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iMankoppai/DSH-Chat-Delete.git"
  },
  "homepage": "https://github.com/iMankoppai/DSH-Chat-Delete#readme",
  "bugs": {
    "url": "https://github.com/iMankoppai/DSH-Chat-Delete/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets",
    "screenshots.json",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node scripts/verify.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  }
}
